# .env.example — copy to .env and fill in your keys

# Primary provider (required for now)
GROQ_API_KEY=your_groq_api_key_here

# Optional providers (uncomment when ready)
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# Storage (optional, defaults to .agent_os/)
# AGENT_MEMORY_DIR=.agent_os/memory
# AGENT_AUDIT_DIR=.agent_os/audit

# Behavior
# AGENT_MODEL=llama-3.1-8b-instant
# AGENT_PROVIDER=groq
# AGENT_MAX_STEPS=20
# AGENT_TEMPERATURE=0.3
